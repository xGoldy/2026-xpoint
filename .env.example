# Public Supabase settings for the browser. Never put the secret or service-role key here.
# Local development: run `npm run db:status` and copy "API URL" and "PUBLISHABLE_KEY".
# Hosted: Supabase → Project Settings → API Keys → publishable key (sb_publishable_…).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE=sb_publishable_your-key
